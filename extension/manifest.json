{
  "manifest_version": 3,
  "name": "Duyệt giá Tuấn Tú",
  "version": "1.0.0",
  "description": "Tải và chạy các script được lưu trên GitHub, tự cập nhật không cần cài lại extension.",
  "minimum_chrome_version": "120",
  "permissions": ["userScripts", "storage", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Duyệt giá Tuấn Tú",
    "default_popup": "popup.html"
  }
}
